<Window x:Class="DrawingStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DrawingStudio.App.Controls"
        Title="{Binding DocumentTitle, StringFormat='Drawing Studio - {0}'}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="12.5"
        Foreground="{StaticResource Ink}" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ RIBBON -->
        <Grid Grid.Row="0">
            <TabControl Background="{StaticResource RibbonBack}" BorderBrush="{StaticResource RibbonLine}" BorderThickness="0,1,0,1"
                        Padding="0" Margin="64,2,0,0">
                <TabItem Header="Home" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Model" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenModelCommand}" ToolTip="Open an .rvt in Revit and show it here">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoOpen}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Open&#10;Model" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding RefreshModelCommand}" ToolTip="Read levels, grids, views and sheets again">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoRefresh}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Reload&#10;Model" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding ConnectCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoPlug}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Connect&#10;Revit" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="View" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding RenderPictureCommand}" ToolTip="Render the open view again in Revit">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoPicture}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Refresh&#10;Picture" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding Open3DCommand}" ToolTip="Open the interactive 3D model tab">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoCube}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="3D&#10;Model" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding Load3DCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoRefresh}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Load 3D&#10;from Revit" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenViewInRevitCommand}" ToolTip="Switch Revit to the open view">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoOutRevit}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Open in&#10;Revit" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Changes" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Changes">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoList}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Review&#10;Changes" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding ApplyChangesCommand}" ToolTip="Send all ticked changes to Revit (one undo step)">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoApply}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Apply to&#10;Revit" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Views" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Create" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Plans" ToolTip="Plans per level">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoPlan}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Plan&#10;Views" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenSectionsCommand}" CommandParameter="Grids" ToolTip="Building sections along grids">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoSection}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Grid&#10;Sections" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenSectionsCommand}" CommandParameter="ElementsLongitudinal" ToolTip="Along beams/walls selected in Revit">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoLongSection}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Long&#10;Section" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenSectionsCommand}" CommandParameter="ElementsCross" ToolTip="Across beams/walls/columns selected in Revit">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoCrossSection}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Cross&#10;Section" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Show" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding Open3DCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoCube}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="3D&#10;Model" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding RenderPictureCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoPicture}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Refresh&#10;Picture" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Sheets" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Sheet Composition" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Sheets" ToolTip="Plan ISO 19650-numbered sheets">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoSheet}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="New&#10;Sheets" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Place" ToolTip="Add views to an existing sheet">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoPlace}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Place&#10;Views" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Place" ToolTip="Re-arrange viewports inside the border">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoArrange}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Arrange&#10;Sheet" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Numbering" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Renumber">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoNumber}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Renumber&#10;Sheets" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Annotate" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Dimension" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding AnnotatePresetCommand}" CommandParameter="Dims">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoDim}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Grid&#10;Dimensions" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Tag" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding AnnotatePresetCommand}" CommandParameter="Tags">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoTag}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Tag&#10;Elements" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Datum" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding AnnotatePresetCommand}" CommandParameter="Heads">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoGridHead}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Grid&#10;Heads" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Batch" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding AnnotatePresetCommand}" CommandParameter="All" ToolTip="Dimensions, heads and tags together">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoApply}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Annotate&#10;All" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Analyze" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Check" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="QA">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoCheck}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Check&#10;Drawings" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding OpenIssuesCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoIssues}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Issues&#10;List" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding ShowIssueCommand}" ToolTip="Open the selected issue in Revit">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoOutRevit}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Show in&#10;Revit" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Manage" Style="{StaticResource RibbonTab}">
                    <StackPanel Orientation="Horizontal" Height="88" Margin="4,4,0,0">
                        <HeaderedContentControl Header="Settings" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding OpenToolCommand}" CommandParameter="Standards">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoBook}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Project&#10;Standards" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding SaveStandardsCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoSave}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Save&#10;Standards" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RB}" Command="{Binding ResetStandardsCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoReset}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Reset to&#10;ISO" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Revit Link" Style="{StaticResource RibbonPanel}">
                            <StackPanel Margin="4,6,4,0" Width="230">
                                <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Find Revit" Command="{Binding RefreshSessionsCommand}" Padding="10,3" />
                                    <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="10,3" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Window" Style="{StaticResource RibbonPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RB}" Command="{Binding ToggleLogCommand}">
                                    <StackPanel>
                                        <Path Data="{StaticResource IcoLog}" Style="{StaticResource RibbonIcon}" />
                                        <TextBlock Style="{StaticResource RBLabel}" Text="Activity&#10;Log" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- File button, like Revit's blue File tab -->
            <Button x:Name="FileButton" Content="File" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" Height="24" Margin="2,2,0,0"
                    Background="#2F6FB5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Padding="0" Click="FileButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open model…" Command="{Binding OpenModelCommand}" />
                        <MenuItem Header="Reload model" Command="{Binding RefreshModelCommand}" />
                        <Separator />
                        <MenuItem Header="Apply changes to Revit" Command="{Binding ApplyChangesCommand}" />
                        <MenuItem Header="Save standards" Command="{Binding SaveStandardsCommand}" />
                        <Separator />
                        <MenuItem Header="Exit" Click="Exit_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- always-visible apply button, top right -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,8,0">
                <TextBlock Text="{Binding DocumentTitle}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="{Binding ApplyLabel}" Style="{StaticResource Primary}" Command="{Binding ApplyChangesCommand}"
                        Padding="12,2" Margin="0" ToolTip="Send every ticked change to Revit in one step (one Ctrl+Z undoes it)" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ WORK AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="400" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- project browser -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                    <TextBlock Text="{Binding Model.DocumentTitle, StringFormat='Project Browser - {0}', FallbackValue='Project Browser'}" TextTrimming="CharacterEllipsis" />
                </Border>
                <TextBox DockPanel.Dock="Top" Margin="6" Text="{Binding BrowserFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search views and sheets" />
                <TreeView x:Name="BrowserTreeView" ItemsSource="{Binding BrowserTree}" BorderThickness="0" SelectedItemChanged="BrowserTree_SelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="1,1" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Detail}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource RibbonLine}" />

            <!-- view tabs + view area -->
            <DockPanel Grid.Column="2">
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDoc}"
                         BorderThickness="0,0,0,1" BorderBrush="{StaticResource RibbonLine}" Background="#EEF0F3"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="2,2,2,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="tab" Background="#E3E6EA" BorderBrush="{StaticResource RibbonLine}" BorderThickness="1,1,1,0"
                                                Margin="0,0,2,0" Padding="8,3,4,3" MaxWidth="260">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="tab" Property="Background" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                <Button Content="✕" Command="{Binding DataContext.CloseDocCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4,0" Margin="6,0,0,0"
                                        Foreground="{StaticResource Muted}" ToolTip="Close" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Background="White">
                    <!-- nothing open -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding CenterEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drawing Studio" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyHint}" Foreground="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
                        <Button Content="Open model…" Style="{StaticResource Primary}" Command="{Binding OpenModelCommand}" HorizontalAlignment="Center" Margin="0" />
                    </StackPanel>

                    <!-- picture of a view or sheet, rendered by Revit -->
                    <DockPanel Visibility="{Binding CenterPicture, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Bottom" Background="#F5F6F7" >
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4">
                                <ComboBox Width="150" ItemsSource="{Binding PictureQualities}" SelectedItem="{Binding PictureQuality}" DisplayMemberPath="Label" Margin="0,0,6,0" />
                                <Button Content="Refresh" Command="{Binding RenderPictureCommand}" Padding="10,2" />
                                <Button Content="Open in Revit" Command="{Binding OpenViewInRevitCommand}" Padding="10,2" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding ViewerStatus}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <c:ZoomImage Source="{Binding ViewImage}" />
                    </DockPanel>

                    <!-- interactive 3D -->
                    <Grid Visibility="{Binding Center3D, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Background="#F5F6F7">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4">
                                    <Button Content="Iso" Click="View3D_Click" Tag="Iso" Padding="10,2" />
                                    <Button Content="Top" Click="View3D_Click" Tag="Top" Padding="10,2" />
                                    <Button Content="Front" Click="View3D_Click" Tag="Front" Padding="10,2" />
                                    <Button Content="Right" Click="View3D_Click" Tag="Right" Padding="10,2" />
                                    <Button Content="Load 3D from Revit" Command="{Binding Load3DCommand}" Padding="10,2" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Info, ElementName=Viewer3D}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <c:ModelView3D x:Name="Viewer3D" ModelFile="{Binding Model3DFile}" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" Background="#FAFBFC">
                            <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                                <DockPanel>
                                    <TextBlock Text="Visibility" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="All" Style="{StaticResource Link}" Click="Layers_All" />
                                        <Button Content="None" Style="{StaticResource Link}" Click="Layers_None" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding Layers, ElementName=Viewer3D}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsVisible}" Margin="0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="12" Height="12" Background="{Binding Swatch}" CornerRadius="2" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- live preview of the active tool -->
                    <DockPanel Visibility="{Binding CenterPreview, Converter={StaticResource BoolToVis}}" Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ToolTitle, StringFormat='Live preview: {0}'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Updates as you change the options on the right. Sections: red = cut, arrows = looking direction, shaded = far clip. Sheets: green = new view, blue = already on the sheet, red = does not fit." />
                        <c:DiagramView Diagram="{Binding ToolDiagram}" />
                    </DockPanel>

                    <!-- prepared changes -->
                    <DockPanel Visibility="{Binding CenterChanges, Converter={StaticResource BoolToVis}}" Margin="10">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                   Text="Nothing here has touched Revit yet. Untick, reorder or remove, then Apply to Revit. Select a row to see its preview on the right." />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="▲ Up" Command="{Binding MoveChangeUpCommand}" CommandParameter="{Binding SelectedChange}" />
                            <Button Content="▼ Down" Command="{Binding MoveChangeDownCommand}" CommandParameter="{Binding SelectedChange}" />
                            <Button Content="Remove" Command="{Binding RemoveChangeCommand}" CommandParameter="{Binding SelectedChange}" />
                            <Button Content="Clear all" Command="{Binding ClearChangesCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="{StaticResource Line}" HorizontalGridLinesBrush="{StaticResource Line}" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Apply" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Change" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Prepared" Binding="{Binding Created}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- QA issues -->
                    <DockPanel Visibility="{Binding CenterIssues, Converter={StaticResource BoolToVis}}" Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding QaSummary}" Style="{StaticResource Hint}" />
                        <DataGrid ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="{StaticResource Line}" HorizontalGridLinesBrush="{StaticResource Line}" RowHeight="26">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowIssueCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
                                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="140" />
                                <DataGridTextColumn Header="Item" Binding="{Binding ElementName}" Width="*" />
                                <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- standards editor -->
                    <DockPanel Visibility="{Binding CenterStandards, Converter={StaticResource BoolToVis}}" Margin="10" Background="{StaticResource Surface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Width" Value="380" />
                                </Style>
                            </WrapPanel.Resources>

                            <!-- ISO 19650 -->
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="ISO 19650 container name" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Project-Originator-Volume-Level-Type-Role-Number, e.g. PRJ-ORG-ZZ-01-DR-S-0001." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Project" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Standards.ProjectCode}" />
                                        <TextBlock Grid.Row="1" Text="Originator" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Standards.Originator}" />
                                        <TextBlock Grid.Row="2" Text="Volume / system" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Standards.Volume}" />
                                        <TextBlock Grid.Row="3" Text="Default level" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Standards.DefaultLevelCode}" />
                                        <TextBlock Grid.Row="4" Text="Information type" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Standards.InfoType}" />
                                        <TextBlock Grid.Row="5" Text="Role" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Standards.Role}" ToolTip="A architect, S structural, M mechanical, E electrical, P plumbing, C civil" />
                                        <TextBlock Grid.Row="6" Text="Number digits" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Standards.NumberDigits}" />
                                        <TextBlock Grid.Row="7" Text="Start / step" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="80" Text="{Binding Standards.StartNumber}" />
                                            <TextBox Width="60" Margin="8,3,0,3" Text="{Binding Standards.NumberStep}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="8" Text="Number pattern" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Standards.SheetNumberTemplate}" />
                                        <TextBlock Grid.Row="9" Text="Upper-case names" Style="{StaticResource FieldLabel}" />
                                        <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Standards.Uppercase}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- title block -->
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="Title block (ISO 7200)" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Values written to new sheets. Right column: the Revit parameter that receives each value." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Drawn by" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding Standards.DrawnBy}" Margin="0,3,6,3" />
                                        <TextBox Grid.Column="2" Text="{Binding Standards.ParamDrawnBy}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="1" Text="Checked by" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Standards.CheckedBy}" Margin="0,3,6,3" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Standards.ParamCheckedBy}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="2" Text="Approved by" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Standards.ApprovedBy}" Margin="0,3,6,3" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Standards.ParamApprovedBy}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="3" Text="Suitability" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SuitabilityCodes}"
                                                  Text="{Binding Standards.Suitability}" Margin="0,3,6,3" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Standards.ParamSuitability}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="4" Text="Revision" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Standards.Revision}" Margin="0,3,6,3" />
                                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Standards.ParamRevision}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Row="5" Text="QA requires" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Standards.RequiredSheetParamsText}"
                                                 ToolTip="Comma-separated parameter names that must not be empty on any sheet." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- sheet layout -->
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="Sheet layout (ISO 5457)" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Drawing area = title block outline minus borders and the title strip. Paper millimetres." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Left (binding) margin" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding Standards.MarginLeftMm}" />
                                        <TextBlock Grid.Row="1" Text="Other margins" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Standards.MarginOtherMm}" />
                                        <TextBlock Grid.Row="2" Text="Title strip side" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TitleStripSides}" SelectedItem="{Binding Standards.TitleStripSide}" />
                                        <TextBlock Grid.Row="3" Text="Title strip width" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Standards.TitleStripMm}" />
                                        <TextBlock Grid.Row="4" Text="Gap between views" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Standards.ViewportGapMm}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- views -->
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="Views and scales (ISO 5455)" Style="{StaticResource SectionTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Plan scale  1 :" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding Standards.PlanScale}" />
                                        <TextBlock Grid.Row="1" Text="Section scale  1 :" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Standards.SectionScale}" />
                                        <TextBlock Grid.Row="2" Text="Allowed scales" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Standards.AllowedScalesText}" />
                                        <TextBlock Grid.Row="3" Text="Plan name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Standards.PlanNameTemplate}" />
                                        <TextBlock Grid.Row="4" Text="Section name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Standards.SectionNameTemplate}" />
                                        <TextBlock Grid.Row="5" Text="View name rule (regex)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Standards.ViewNameRegex}" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource RibbonLine}" />

            <!-- properties palette -->
            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" Style="{StaticResource PaletteTitle}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕ Close tool" Command="{Binding CloseToolCommand}" Padding="6,0" Margin="0"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                                Visibility="{Binding IsToolActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock>
                            <Run Text="Properties" />
                            <Run Text="  ·  " Foreground="{StaticResource Muted}" />
                            <Run Text="{Binding ToolTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,10,12">
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=None}">
                            <TextBlock Text="Identity Data" Style="{StaticResource PaletteGroup}" />
                            <ItemsControl ItemsSource="{Binding PropertyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Padding="2,4" Foreground="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Padding="6,4" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="Open a view or sheet from the Project Browser to see its properties. Pick a tool on the ribbon to prepare plans, sections, sheets or annotation; its options appear here and its live preview opens as a tab." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Plans}">
                            <TextBlock Text="Levels" Style="{StaticResource PaletteGroup}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="All" Style="{StaticResource Link}" Command="{Binding CheckAllCommand}" CommandParameter="{Binding Levels}" />
                                <Button Content="None" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}" CommandParameter="{Binding Levels}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Levels}" Style="{StaticResource CheckList}" Height="200" />
                            <TextBlock Text="View" Style="{StaticResource PaletteGroup}" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Plan type" Width="120" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PlanKinds}" SelectedItem="{Binding PlanKind}" DisplayMemberPath="Label" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="View template" Width="120" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PlanTemplates}" SelectedItem="{Binding PlanTemplate}" DisplayMemberPath="Name" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Scale 1 :" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.PlanScale}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Name pattern" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.PlanNameTemplate}" ToolTip="{}{Role} {PlanKind} {LevelName} {LevelCode} {Scale}" />
                            </DockPanel>
                            <Button Content="Add plans to changes" Style="{StaticResource Primary}" Command="{Binding CreatePlansCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding PlansPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Sections}">
                            <TextBlock Text="Mode" Style="{StaticResource PaletteGroup}" />
                            <ComboBox ItemsSource="{Binding SectionModes}" SelectedItem="{Binding SectionMode}" DisplayMemberPath="Label" />
                            <StackPanel Visibility="{Binding IsGridSectionMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Grids" Style="{StaticResource PaletteGroup}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="All" Style="{StaticResource Link}" Command="{Binding CheckAllCommand}" CommandParameter="{Binding Grids}" />
                                <Button Content="None" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}" CommandParameter="{Binding Grids}" />
                            </StackPanel>
                                <ListBox ItemsSource="{Binding Grids}" Style="{StaticResource CheckList}" Height="140">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="80" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsElementSectionMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Elements" Style="{StaticResource PaletteGroup}" />
                                <Button Content="Use Revit selection" Command="{Binding ReadSelectionCommand}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <TextBlock Text="View" Style="{StaticResource PaletteGroup}" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="View template" Width="120" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SectionTemplates}" SelectedItem="{Binding SectionTemplate}" DisplayMemberPath="Name" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Scale 1 :" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.SectionScale}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Far clip (mm)" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.SectionDepthMm}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Cut offset (mm)" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.SectionOffsetMm}" ToolTip="Positive moves the cut towards the viewer" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Extent pad (mm)" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.SectionPaddingMm}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Name pattern" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.SectionNameTemplate}" ToolTip="{}{Role} {Kind} {Ref} {Category} {Index} {Scale}" />
                            </DockPanel>
                            <CheckBox Content="Flip looking direction" IsChecked="{Binding SectionFlip}" Margin="0,6,0,0" />
                            <Button Content="Add sections to changes" Style="{StaticResource Primary}" Command="{Binding CreateSectionsCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SectionsPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Sheets}">
                            <TextBlock Text="Views" Style="{StaticResource PaletteGroup}" />
                            <TextBox Text="{Binding SheetViewFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name" />
                            <DockPanel Margin="0,4">
                                <CheckBox Content="Only views not on a sheet" IsChecked="{Binding OnlyUnplaced}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="All" Style="{StaticResource Link}" Command="{Binding CheckAllCommand}" CommandParameter="{Binding SheetViewsView}" />
                                    <Button Content="None" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}" CommandParameter="{Binding SheetViewsView}" Margin="0" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding SheetViewsView}" Style="{StaticResource CheckList}" Height="200" />
                            <TextBlock Text="Sheets to create" Style="{StaticResource PaletteGroup}" />
                            <RadioButton Content="One sheet per view" GroupName="sheetMode" IsChecked="{Binding OneSheetPerView}" Margin="0,2" />
                            <RadioButton Content="All ticked views on one sheet:" GroupName="sheetMode" IsChecked="{Binding CombineOnOneSheet}" Margin="0,2" />
                            <TextBox Text="{Binding CombinedSheetName}" Margin="20,2,0,4" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Title block" Width="120" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding TitleBlocks}" SelectedItem="{Binding TitleBlock}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                <Button Content="Add to list" Command="{Binding GenerateSheetListCommand}" />
                                <Button Content="Clear list" Command="{Binding ClearSheetListCommand}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PlannedSheets}" SelectedItem="{Binding SelectedPlannedSheet}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Line}"
                                      HorizontalGridLinesBrush="{StaticResource Line}" RowHeight="26" Height="180">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="28" />
                                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="*" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <CheckBox Content="Place views on the new sheets" IsChecked="{Binding AutoPlace}" Margin="0,8,0,2" />
                            <CheckBox Content="Number details in reading order" IsChecked="{Binding RenumberDetails}" />
                            <Button Content="Add sheets to changes" Style="{StaticResource Primary}" Command="{Binding CreateSheetsCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <TextBlock Text="{Binding SheetCaption}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SheetsPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Place}">
                            <TextBlock Text="Sheet" Style="{StaticResource PaletteGroup}" />
                            <ComboBox ItemsSource="{Binding ExistingSheets}" SelectedItem="{Binding TargetSheet}" />
                            <TextBlock Text="Views to add" Style="{StaticResource PaletteGroup}" />
                            <TextBox Text="{Binding SheetViewFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name" />
                            <CheckBox Content="Only views not on a sheet" IsChecked="{Binding OnlyUnplaced}" Margin="0,4" />
                            <ListBox ItemsSource="{Binding SheetViewsView}" Style="{StaticResource CheckList}" Height="240" />
                            <CheckBox Content="Number details in reading order" IsChecked="{Binding RenumberDetails}" Margin="0,8,0,0" />
                            <WrapPanel>
                                <Button Content="Add: place ticked views" Style="{StaticResource Primary}" Command="{Binding PlaceOnSheetCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                                <Button Content="Add: re-arrange sheet" Style="{StaticResource {x:Type Button}}" Command="{Binding RelayoutSheetCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            </WrapPanel>
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <TextBlock Text="{Binding SheetCaption}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding PlacePreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Annotate}">
                            <TextBlock Text="Views" Style="{StaticResource PaletteGroup}" />
                            <TextBox Text="{Binding AnnotViewFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name" />
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Button Content="All" Style="{StaticResource Link}" Command="{Binding CheckAllCommand}" CommandParameter="{Binding AnnotViewsView}" />
                                <Button Content="None" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}" CommandParameter="{Binding AnnotViewsView}" />
                                <Button Content="Active Revit view" Style="{StaticResource Link}" Command="{Binding CheckActiveViewCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding AnnotViewsView}" Style="{StaticResource CheckList}" Height="200" />
                            <TextBlock Text="Dimensions" Style="{StaticResource PaletteGroup}" />
                            <CheckBox Content="Dimension grids (plans)" IsChecked="{Binding DimensionGrids}" />
                            <CheckBox Content="Overall dimension" IsChecked="{Binding OverallDimension}" Margin="20,2,0,2" />
                            <CheckBox Content="Both ends of the grids" IsChecked="{Binding BothSides}" Margin="20,2,0,2" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Offset (mm paper)" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.DimOffsetMm}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="String gap (mm)" Width="120" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Standards.DimGapMm}" />
                            </DockPanel>
                            <TextBlock Text="Datum" Style="{StaticResource PaletteGroup}" />
                            <CheckBox Content="Grid heads at both ends" IsChecked="{Binding GridBubbles}" />
                            <TextBlock Text="Tags" Style="{StaticResource PaletteGroup}" />
                            <CheckBox Content="Tag elements" IsChecked="{Binding TagElements}" />
                            <CheckBox Content="Skip elements already tagged" IsChecked="{Binding SkipTagged}" Margin="20,2,0,2" />
                            <CheckBox Content="With leader" IsChecked="{Binding TagLeader}" Margin="20,2,0,2" />
                            <ItemsControl ItemsSource="{Binding TagCategories}" ItemTemplate="{StaticResource CheckRow}" Margin="20,4,0,0" />
                            <Button Content="Add annotation to changes" Style="{StaticResource Primary}" Command="{Binding AnnotateCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding AnnotationPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Renumber}">
                            <TextBlock Text="Sheets" Style="{StaticResource PaletteGroup}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="All" Style="{StaticResource Link}" Command="{Binding CheckAllCommand}" CommandParameter="{Binding RenumberSheets}" />
                                <Button Content="None" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}" CommandParameter="{Binding RenumberSheets}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding RenumberSheets}" Style="{StaticResource CheckList}" Height="260" />
                            <Button Content="Add: renumber sheets" Style="{StaticResource Primary}" Command="{Binding RenumberSheetsCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add: renumber details from" Command="{Binding RenumberDetailsCommand}" Margin="0,0,6,0" />
                                <TextBox Width="44" Text="{Binding DetailStart}" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource PaletteGroup}" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding RenumberPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DetailsPreview}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=QA}">
                            <TextBlock Text="Checks" Style="{StaticResource PaletteGroup}" />
                            <ItemsControl ItemsSource="{Binding QaChecksList}" ItemTemplate="{StaticResource CheckRow}" />
                            <Button Content="Run checks" Style="{StaticResource Primary}" Command="{Binding RunQaCommand}" HorizontalAlignment="Left" Margin="0,10,8,0" />
                            <TextBlock Text="{Binding QaSummary}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Changes}">
                            <TextBlock Text="Selected change" Style="{StaticResource PaletteGroup}" />
                            <TextBlock Text="{Binding SelectedChange.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedChange.Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Border Style="{StaticResource PreviewPanel}">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedChange.Summary}" Style="{StaticResource PreviewText}" />
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="Apply" Style="{StaticResource PaletteGroup}" />
                            <CheckBox Content="All or nothing (undo the batch if one change fails)" IsChecked="{Binding AllOrNothing}" />
                            <Button Content="{Binding ApplyLabel}" Style="{StaticResource Primary}" Command="{Binding ApplyChangesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Everything is applied as one step in Revit: a single Ctrl+Z undoes the whole batch." />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ActiveTool, Converter={StaticResource IsTool}, ConverterParameter=Standards}">
                            <TextBlock Text="Project standard" Style="{StaticResource PaletteGroup}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Edit the rules in the Standards tab in the middle. They drive sheet numbers, view names, scales, title block values and sheet layout." />
                            <Button Content="Save standards" Style="{StaticResource Primary}" Command="{Binding SaveStandardsCommand}" HorizontalAlignment="Left" />
                            <Button Content="Reset to ISO defaults" Command="{Binding ResetStandardsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ============================================================ ACTIVITY LOG -->
        <Border Grid.Row="2" Height="120" BorderBrush="{StaticResource RibbonLine}" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Background="#EEF0F3">
                    <Button DockPanel.Dock="Right" Content="Hide" Style="{StaticResource Link}" Command="{Binding ToggleLogCommand}" Margin="0,2,8,2" />
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource Link}" Command="{Binding ClearLogCommand}" Margin="0,2,10,2" />
                    <TextBlock Text="Activity" FontWeight="SemiBold" Margin="8,2" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Log}" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}" />
            </DockPanel>
        </Border>

        <!-- ============================================================ STATUS BAR -->
        <StatusBar Grid.Row="3" Background="#EEF0F3" BorderBrush="{StaticResource RibbonLine}" BorderThickness="0,1,0,0" Padding="6,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="110" Height="8" IsIndeterminate="{Binding IsBusy}" Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B0B7BF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Not connected to Revit" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="{Binding SelectedSession, StringFormat='Connected to {0}'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ApplyLabel}" Foreground="{StaticResource Muted}" Margin="16,0,0,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
