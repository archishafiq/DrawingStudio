<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DrawingStudio</AssemblyName>
    <RootNamespace>DrawingStudio.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>Drawing Studio for Revit</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The Revit add-ins (one per Revit version) travel inside the exe; the app installs them on first run. -->
  <ItemGroup Condition="'$(BridgeBundle)' != '' And Exists('$(BridgeBundle)')">
    <EmbeddedResource Include="$(BridgeBundle)" LogicalName="bridges.zip" />
  </ItemGroup>

</Project>
