<Application x:Class="DrawingStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DrawingStudio.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1F2933" />
        <SolidColorBrush x:Key="Muted" Color="#66727F" />
        <SolidColorBrush x:Key="Line" Color="#DDE2E7" />
        <SolidColorBrush x:Key="Surface" Color="#F6F7F9" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#0F5C6E" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E3EFF2" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <!-- Checklist row: label plus muted detail -->
        <DataTemplate x:Key="CheckRow">
            <CheckBox IsChecked="{Binding IsChecked}" Margin="2,2">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <Style x:Key="CheckList" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource CheckRow}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ============================================================ Revit-style shell -->
        <c:EqualsToVisibility x:Key="IsTool" />
        <c:EqualsToBool x:Key="IsToolBool" />

        <!-- ribbon icons (24 x 24 line drawings) -->
        <StreamGeometry x:Key="IcoOpen">M3,7 L3,19 L21,19 L21,9 L11,9 L9,7 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoRefresh">M19,12 A7,7 0 1 1 16.5,6.6 M17,3 L17,7 L13,7</StreamGeometry>
        <StreamGeometry x:Key="IcoApply">M4,4 L20,4 L20,20 L4,20 Z M7.5,12.5 L10.5,15.5 L16.5,8.5</StreamGeometry>
        <StreamGeometry x:Key="IcoPicture">M3,5 L21,5 L21,19 L3,19 Z M6,16 L10,11 L13,14 L15,12 L19,16 M17,9 A1.5,1.5 0 1 1 14,9 A1.5,1.5 0 1 1 17,9</StreamGeometry>
        <StreamGeometry x:Key="IcoCube">M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 L12,21</StreamGeometry>
        <StreamGeometry x:Key="IcoOutRevit">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,20 L4,20 L4,6 L10,6</StreamGeometry>
        <StreamGeometry x:Key="IcoPlan">M3,3 L21,3 L21,21 L3,21 Z M3,12 L12,12 L12,21 M12,3 L12,8 M16,12 L21,12</StreamGeometry>
        <StreamGeometry x:Key="IcoSection">M3,12 L21,12 M3,12 L3,6 L7,6 M21,12 L21,6 L17,6 M3,16 L21,16 L21,20 L3,20 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoLongSection">M3,9 L21,9 L21,13 L3,13 Z M2,17 L22,17 M2,17 L2,20 M22,17 L22,20</StreamGeometry>
        <StreamGeometry x:Key="IcoCrossSection">M8,4 L16,4 L16,20 L8,20 Z M3,12 L21,12 M3,12 L3,9 M21,12 L21,9</StreamGeometry>
        <StreamGeometry x:Key="IcoSheet">M4,3 L20,3 L20,21 L4,21 Z M4,17 L20,17 M14,17 L14,21</StreamGeometry>
        <StreamGeometry x:Key="IcoPlace">M4,3 L20,3 L20,21 L4,21 Z M7,6 L14,6 L14,13 L7,13 Z M16,6 L17,6 M16,9 L17,9 M4,17 L20,17</StreamGeometry>
        <StreamGeometry x:Key="IcoArrange">M4,3 L20,3 L20,21 L4,21 Z M7,6 L11,6 L11,10 L7,10 Z M13,6 L17,6 L17,10 L13,10 Z M7,12 L11,12 L11,16 L7,16 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoNumber">M9,4 L7,20 M17,4 L15,20 M4,9 L20,9 M4,15 L20,15</StreamGeometry>
        <StreamGeometry x:Key="IcoDim">M3,7 L3,17 M12,7 L12,17 M21,7 L21,17 M3,12 L21,12 M2,13 L4,11 M11,13 L13,11 M20,13 L22,11</StreamGeometry>
        <StreamGeometry x:Key="IcoTag">M3,12 L9,6 L21,6 L21,18 L9,18 Z M11,12 A1.5,1.5 0 1 1 8,12 A1.5,1.5 0 1 1 11,12</StreamGeometry>
        <StreamGeometry x:Key="IcoGridHead">M15,5 A3,3 0 1 1 9,5 A3,3 0 1 1 15,5 M12,8 L12,22</StreamGeometry>
        <StreamGeometry x:Key="IcoCheck">M12,3 L20,6 L20,12 C20,17 16,20 12,21 C8,20 4,17 4,12 L4,6 Z M8.5,12 L11,14.5 L15.5,9.5</StreamGeometry>
        <StreamGeometry x:Key="IcoList">M8,6 L20,6 M8,12 L20,12 M8,18 L20,18 M4,5 L5,5 L5,7 L4,7 Z M4,11 L5,11 L5,13 L4,13 Z M4,17 L5,17 L5,19 L4,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoBook">M5,4 L19,4 L19,20 L5,20 Z M5,16 L19,16 M9,8 L15,8 M9,11 L15,11</StreamGeometry>
        <StreamGeometry x:Key="IcoSave">M5,4 L17,4 L20,7 L20,20 L5,20 Z M8,4 L8,9 L16,9 L16,4 M8,20 L8,14 L16,14 L16,20</StreamGeometry>
        <StreamGeometry x:Key="IcoPlug">M9,3 L9,8 M15,3 L15,8 M7,8 L17,8 L17,12 C17,15 15,17 12,17 C9,17 7,15 7,12 Z M12,17 L12,21</StreamGeometry>
        <StreamGeometry x:Key="IcoReset">M5,12 A7,7 0 1 0 7.5,6.6 M7,3 L7,7 L11,7</StreamGeometry>
        <StreamGeometry x:Key="IcoClear">M5,7 L19,7 M10,7 L10,4 L14,4 L14,7 M7,7 L8,20 L16,20 L17,7</StreamGeometry>
        <StreamGeometry x:Key="IcoIssues">M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.5 L12,17.5</StreamGeometry>
        <StreamGeometry x:Key="IcoLog">M4,4 L20,4 L20,20 L4,20 Z M7,8 L17,8 M7,12 L17,12 M7,16 L13,16</StreamGeometry>

        <SolidColorBrush x:Key="RibbonBack" Color="#F5F6F7" />
        <SolidColorBrush x:Key="RibbonLine" Color="#D6DADF" />
        <SolidColorBrush x:Key="Hover" Color="#E2EEF8" />
        <SolidColorBrush x:Key="HoverLine" Color="#B9D6EE" />

        <Style x:Key="RibbonIcon" TargetType="Path">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Margin" Value="0,2,0,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- large ribbon push button: icon over a one- or two-line label -->
        <Style x:Key="RB" TargetType="Button">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HoverLine}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CFE3F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RBLabel" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <!-- ribbon panel: buttons with the panel title underneath and a separator on the right -->
        <Style x:Key="RibbonPanel" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="{StaticResource RibbonLine}" BorderThickness="0,0,1,0" Padding="4,2,4,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,2" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ribbon tab headers -->
        <Style x:Key="RibbonTab" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="12,4" Margin="0,0,1,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RibbonBack}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource RibbonLine}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- palette title bar (Project Browser / Properties) -->
        <Style x:Key="PaletteTitle" TargetType="Border">
            <Setter Property="Background" Value="#EEF0F3" />
            <Setter Property="BorderBrush" Value="{StaticResource RibbonLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="PaletteGroup" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#E6E9ED" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="-10,10,-10,4" />
        </Style>

        <!-- live preview of what the Add button will prepare -->
        <Style x:Key="PreviewPanel" TargetType="Border">
            <Setter Property="Background" Value="#F3F7F8" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="PreviewText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PreviewTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Application.Resources>
</Application>
